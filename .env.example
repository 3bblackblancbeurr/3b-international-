# Server only. Put actual secret values in Vercel or .env.local, never in GitHub/chat.
SHOP_ENABLED=false
# Second human-controlled launch gate. Keep false until legal/admin + Stripe E2E are validated.
SHOP_RELEASE_APPROVED=false
# Dedicated server-side HMAC secret for checkout confirmation cookies (>= 32 random characters).
SHOP_CHECKOUT_COOKIE_SECRET=
APP_URL=https://3b-international.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PWA QuickKit — keep checkout disabled until live Stripe + legal checks are complete.
PWA_QUICKKIT_PUBLIC_URL=https://3b-international.vercel.app/pwa-quickkit/
PWA_QUICKKIT_CHECKOUT_ENABLED=false
PWA_QUICKKIT_PRO_PRICE_ID=
# Local/test-only fallback to the prepared Stripe test price. Never enable this with a live secret key.
PWA_QUICKKIT_ENABLE_TEST_CHECKOUT=0
PWA_QUICKKIT_STRIPE_WEBHOOK_SECRET=
# Optional dedicated HMAC key for privacy-safe IP rate-limit hashing; falls back to the server Supabase secret if omitted.
PWA_QUICKKIT_RATE_LIMIT_SECRET=
# Products marked shop_visible=true in Stripe appear without code changes.
STRIPE_CATALOG_MODE=metadata
# Optional legacy mode: set STRIPE_CATALOG_MODE=allowlist and list price IDs here.
STRIPE_PRICE_IDS=
# For the Pull 3B at 80 €, shipping is included. Set true in Vercel; no Stripe shipping-rate ID is needed.
SHOP_SHIPPING_INCLUDED=false
# Only needed when shipping is not included.
STRIPE_SHIPPING_RATE_ID=
SHOP_SHIPPING_COUNTRIES=FR
SHOP_AUTOMATIC_TAX=false
# Set true only after the relevant tax/VAT registration has been confirmed for the live activity.
SHOP_TAX_REGISTRATION_CONFIRMED=false
SUPABASE_URL=https://ttvhcezucsbbmnafrotq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Seller alerts after Stripe confirms a paid order.
# Transactional email (Resend). Example sender after domain verification: 3B International <commandes@your-domain.fr>
SHOP_SELLER_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
# SMS seller alert (Twilio). Phone numbers must use E.164 format, for example +33612345678.
SHOP_SELLER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional instead of TWILIO_FROM.
TWILIO_MESSAGING_SERVICE_SID=

# Public pre-opening pages. Keep SHOP_ENABLED=false until seller details and Stripe secrets are final.
SHOP_TERMS_URL=https://3b-international.vercel.app/sales-terms.html
SHOP_PRIVACY_URL=https://3b-international.vercel.app/privacy-policy.html
SHOP_SHIPPING_URL=https://3b-international.vercel.app/shipping.html
SHOP_RETURNS_URL=https://3b-international.vercel.app/returns.html
SHOP_LEGAL_URL=https://3b-international.vercel.app/legal-notice.html

# Public feature flag only. Keep false until the packaged ThreeBWorld client registers the threebworld:// protocol.
VITE_UNREAL_LAUNCH_ENABLED=false

# 3B AI Council — server-only placeholders. Never expose these as VITE_* values.
AI_COUNCIL_ENABLED=false
AI_COUNCIL_OWNER_USER_ID=
OPENAI_API_KEY=
AI_COUNCIL_OPENAI_MODEL=
ANTHROPIC_API_KEY=
AI_COUNCIL_ANTHROPIC_MODEL=
GEMINI_API_KEY=
AI_COUNCIL_GEMINI_MODEL=

# 3B Command OS — owner integrations. Server-only. Never expose as VITE_*.
# Google Workspace (Gmail + Calendar) requires a refresh token issued with readonly Gmail/Calendar scopes.
COMMAND_GOOGLE_CLIENT_ID=
COMMAND_GOOGLE_CLIENT_SECRET=
COMMAND_GOOGLE_REFRESH_TOKEN=

# Metricool REST API. Requires API access (Advanced/Custom plan).
# Keep the token server-side. userId/blogId are identifiers, not credentials.
COMMAND_METRICOOL_TOKEN=
COMMAND_METRICOOL_USER_ID=
COMMAND_METRICOOL_BLOG_ID=

# Vercel REST API. Use a scoped token with the minimum required project access.
COMMAND_VERCEL_TOKEN=
COMMAND_VERCEL_PROJECT_ID=
COMMAND_VERCEL_TEAM_ID=

# 3B IA Command uses the OpenAI Responses API with OPENAI_API_KEY above.
# Set an API model that is enabled for the selected OpenAI project.
COMMAND_AI_MODEL=

# Sport H24 — server-only. Never expose this key as VITE_*.
# Used only by /api/sport-live to discover and verify real YouTube live sports streams.
YOUTUBE_API_KEY=
# Optional comma-separated exact official channel titles to extend the built-in rights-holder allowlist.
SPORT_LIVE_TRUSTED_CHANNEL_TITLES=

# Unreal Editor Remote Control — local development only.
THREEB_UNREAL_REMOTE_URL=http://127.0.0.1:30010

# Member authentication hardening.
# Configure Cloudflare Turnstile in Supabase Auth before setting MEMBER_CAPTCHA_REQUIRED=true.
VITE_TURNSTILE_SITE_KEY=
MEMBER_CAPTCHA_REQUIRED=false

# Passport 3B identity proofing — server-only. Keep disabled until a real provider
# has been selected, contracted, configured and its webhook signature verified.
PASSPORT_IDENTITY_VERIFICATION_ENABLED=false
PASSPORT_IDENTITY_PROVIDER=
PASSPORT_IDENTITY_PROVIDER_API_KEY=
PASSPORT_IDENTITY_PROVIDER_WEBHOOK_SECRET=
# Optional pepper/HMAC secret for hashing provider case references before storage.
PASSPORT_IDENTITY_REFERENCE_SECRET=
# Manual production readiness attestations. Keep false until verified in the
# provider contract / Supabase Auth dashboard / sandbox evidence.
PASSPORT_LEAKED_PASSWORD_PROTECTION_CONFIRMED=false
PASSPORT_IDENTITY_LEGAL_REVIEW_APPROVED=false
PASSPORT_IDENTITY_RETENTION_POLICY_APPROVED=false
PASSPORT_IDENTITY_MINORS_POLICY_APPROVED=false
PASSPORT_IDENTITY_SANDBOX_E2E_APPROVED=false

# Privacy-first product analytics — PostHog Cloud EU.
# Public client/write-only project token. Never put a private PostHog API key in VITE_*.
VITE_POSTHOG_PROJECT_TOKEN=phc_rMapCkE5ZQoM6TTAefPrc6DDPcSAQ7MsLfY2UicghUNE
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# 3B Digital Store — fail-closed by default
# Test checkout only works when both the flag and an explicit UUID allowlist are present.
DIGITAL_STORE_TEST_ENABLED=false
DIGITAL_STORE_TEST_USER_IDS=
# Never set true until store policies, native billing, taxes/terms and live QA are validated.
DIGITAL_STORE_LIVE_APPROVED=false

# Passport 3B identity proofing — server-only and fail-closed.
PASSPORT_IDENTITY_VERIFICATION_ENABLED=false
PASSPORT_IDENTITY_PROVIDER=
PASSPORT_IDENTITY_REFERENCE_SECRET=

# IDnow Trust Platform — enable only after sandbox credentials, approved flow and legal/DPA gates.
IDNOW_PHYSICAL_ENV=sandbox
IDNOW_LOGICAL_ENV=staging
IDNOW_CLIENT_ID=
IDNOW_CLIENT_SECRET=
IDNOW_FLOW_ID=
IDNOW_WEBHOOK_AUDIENCE=
IDNOW_PVID_FLOW_APPROVED=false
PASSPORT_LEAKED_PASSWORD_PROTECTION_CONFIRMED=false
PASSPORT_IDENTITY_LEGAL_REVIEW_APPROVED=false
PASSPORT_IDENTITY_RETENTION_POLICY_APPROVED=false
PASSPORT_IDENTITY_MINORS_POLICY_APPROVED=false
PASSPORT_IDENTITY_SANDBOX_E2E_APPROVED=false

# Passport confirmation keys and partner pilot — server-only.
# Open only after migrations, hosted runtime checks and real-device acceptance.
PASSPORT_PASSKEY_STEPUP_ENABLED=false
PASSPORT_WEBAUTHN_RP_ID=
PASSPORT_PARTNER_PILOT_ENABLED=false
# Independent random server secret (32+ characters); never use a public/VITE_* variable.
PASSPORT_PARTNER_SUBJECT_SECRET=

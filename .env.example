# Server only. Put actual secret values in Vercel or .env.local, never in GitHub/chat.
SHOP_ENABLED=false
APP_URL=https://3b-international.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PWA QuickKit — keep checkout disabled until live Stripe + legal checks are complete.
PWA_QUICKKIT_PUBLIC_URL=https://3b-international.vercel.app/pwa-quickkit/
PWA_QUICKKIT_CHECKOUT_ENABLED=false
PWA_QUICKKIT_PRO_PRICE_ID=
# Local/test-only fallback to the prepared Stripe test price. Never enable this with a live secret key.
PWA_QUICKKIT_ENABLE_TEST_CHECKOUT=0
PWA_QUICKKIT_STRIPE_WEBHOOK_SECRET=
# Optional dedicated HMAC key for privacy-safe IP rate-limit hashing; falls back to the server Supabase secret if omitted.
PWA_QUICKKIT_RATE_LIMIT_SECRET=
# Products marked shop_visible=true in Stripe appear without code changes.
STRIPE_CATALOG_MODE=metadata
# Optional legacy mode: set STRIPE_CATALOG_MODE=allowlist and list price IDs here.
STRIPE_PRICE_IDS=
# For the Pull 3B at 80 €, shipping is included. Set true in Vercel; no Stripe shipping-rate ID is needed.
SHOP_SHIPPING_INCLUDED=false
# Only needed when shipping is not included.
STRIPE_SHIPPING_RATE_ID=
SHOP_SHIPPING_COUNTRIES=FR
SHOP_AUTOMATIC_TAX=false
SUPABASE_URL=https://ttvhcezucsbbmnafrotq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Seller alerts after Stripe confirms a paid order.
# Transactional email (Resend). Example sender after domain verification: 3B International <commandes@your-domain.fr>
SHOP_SELLER_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
# SMS seller alert (Twilio). Phone numbers must use E.164 format, for example +33612345678.
SHOP_SELLER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional instead of TWILIO_FROM.
TWILIO_MESSAGING_SERVICE_SID=

# Public pre-opening pages. Keep SHOP_ENABLED=false until seller details and Stripe secrets are final.
SHOP_TERMS_URL=https://3b-international.vercel.app/sales-terms.html
SHOP_PRIVACY_URL=https://3b-international.vercel.app/privacy-policy.html
SHOP_SHIPPING_URL=https://3b-international.vercel.app/shipping.html
SHOP_RETURNS_URL=https://3b-international.vercel.app/returns.html
SHOP_LEGAL_URL=https://3b-international.vercel.app/legal-notice.html

# Public feature flag only. Keep false until the packaged ThreeBWorld client registers the threebworld:// protocol.
VITE_UNREAL_LAUNCH_ENABLED=false

# 3B AI Council — server-only placeholders. Never expose these as VITE_* values.
AI_COUNCIL_ENABLED=false
AI_COUNCIL_OWNER_USER_ID=
OPENAI_API_KEY=
AI_COUNCIL_OPENAI_MODEL=
ANTHROPIC_API_KEY=
AI_COUNCIL_ANTHROPIC_MODEL=
GEMINI_API_KEY=
AI_COUNCIL_GEMINI_MODEL=

# Unreal Editor Remote Control — local development only.
THREEB_UNREAL_REMOTE_URL=http://127.0.0.1:30010

# Member authentication hardening.
# Configure Cloudflare Turnstile in Supabase Auth before setting MEMBER_CAPTCHA_REQUIRED=true.
VITE_TURNSTILE_SITE_KEY=
MEMBER_CAPTCHA_REQUIRED=false

# Privacy-first product analytics — PostHog Cloud EU.
# Public client/write-only project token. Never put a private PostHog API key in VITE_*.
VITE_POSTHOG_PROJECT_TOKEN=phc_rMapCkE5ZQoM6TTAefPrc6DDPcSAQ7MsLfY2UicghUNE
VITE_POSTHOG_HOST=https://eu.i.posthog.com

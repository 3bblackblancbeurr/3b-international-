# Server only. Put actual values in Vercel or .env.local, never in GitHub/chat.
SHOP_ENABLED=false
APP_URL=https://3b-international.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Products marked shop_visible=true in Stripe appear without code changes.
STRIPE_CATALOG_MODE=metadata
# Optional legacy mode: set STRIPE_CATALOG_MODE=allowlist and list price IDs here.
STRIPE_PRICE_IDS=
STRIPE_SHIPPING_RATE_ID=
SHOP_SHIPPING_COUNTRIES=FR
SHOP_AUTOMATIC_TAX=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publish your real sales information, then set its HTTPS URLs.
SHOP_TERMS_URL=
SHOP_PRIVACY_URL=
SHOP_SHIPPING_URL=
SHOP_RETURNS_URL=
SHOP_LEGAL_URL=

{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "git":  {
                "deploymentEnabled":  {
                                          "*":  false,
                                          "main":  true,
                                          "chatgpt-vercel-probe-base":  true
                                      }
            },
    "functions":  {
                      "api/*.js":  {
                                       "maxDuration":  60
                                   }
                  },
    "headers":  [
                    {
                        "source":  "/:path((?!religion(?:/|$)).*)",
                        "headers":  [
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "no-referrer"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "DENY"
                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(self), geolocation=(self)"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027 https://ttvhcezucsbbmnafrotq.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; img-src \u0027self\u0027 data: blob: https:; font-src \u0027self\u0027 data:; connect-src \u0027self\u0027 blob: https://ttvhcezucsbbmnafrotq.supabase.co wss://ttvhcezucsbbmnafrotq.supabase.co https://eu.i.posthog.com; media-src \u0027self\u0027 blob:; worker-src \u0027self\u0027 blob:; object-src \u0027none\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027none\u0027; form-action \u0027self\u0027 https://checkout.stripe.com; upgrade-insecure-requests"
                                        }
                                    ]
                    },
                    {
                        "source":  "/religion/:path*",
                        "headers":  [
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027; frame-src \u0027self\u0027 https://www.youtube-nocookie.com; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https://fonts.googleapis.com; img-src \u0027self\u0027 data: https://tile.openstreetmap.org; font-src \u0027self\u0027 https://fonts.gstatic.com; connect-src \u0027self\u0027; object-src \u0027none\u0027; base-uri \u0027self\u0027; frame-ancestors \u0027self\u0027; form-action \u0027self\u0027; upgrade-insecure-requests"
                                        },
                                        {
                                            "key":  "X-Frame-Options",
                                            "value":  "SAMEORIGIN"
                                        },
                                        {
                                            "key":  "X-Content-Type-Options",
                                            "value":  "nosniff"
                                        },
                                        {
                                            "key":  "Referrer-Policy",
                                            "value":  "strict-origin-when-cross-origin"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        }
                                    ]
                    },
                    {
                        "source":  "/",
                        "headers":  [
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=31536000; includeSubDomains"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        }
                                    ]
                    }
                ],
    "rewrites":  [
                     {
                         "source":  "/jeux/:slug",
                         "destination":  "/index.html"
                     }
                 ],
    "redirects":  [
                      {
                          "source":  "/application-3b",
                          "destination":  "/application-3b-international.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/application",
                          "destination":  "/application-3b-international.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/app",
                          "destination":  "/application-3b-international.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/iphone",
                          "destination":  "/install-iphone.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/ios",
                          "destination":  "/install-iphone.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/installer",
                          "destination":  "/install.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/telecharger",
                          "destination":  "/install.html",
                          "permanent":  true
                      },
                      {
                          "source":  "/android",
                          "destination":  "/install-android.html",
                          "permanent":  true
                      }
                  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://ttvhcezucsbbmnafrotq.supabase.co; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: https://ttvhcezucsbbmnafrotq.supabase.co wss://ttvhcezucsbbmnafrotq.supabase.co; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://checkout.stripe.com; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/jeux/:slug",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/application-3b",
      "destination": "/application-3b-international.html",
      "permanent": true
    },
    {
      "source": "/application",
      "destination": "/application-3b-international.html",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/application-3b-international.html",
      "permanent": true
    },
    {
      "source": "/iphone",
      "destination": "/install-iphone.html",
      "permanent": true
    },
    {
      "source": "/ios",
      "destination": "/install-iphone.html",
      "permanent": true
    },
    {
      "source": "/installer",
      "destination": "/install.html",
      "permanent": true
    },
    {
      "source": "/telecharger",
      "destination": "/install.html",
      "permanent": true
    },
    {
      "source": "/android",
      "destination": "/install-android.html",
      "permanent": true
    }
  ]
}

# Build outputs and local QA artifacts are regenerated by Vercel.
dist/
coverage/
artifacts/
outputs/

# Native and Unreal projects are distributed independently of the web build.
android/
ios/
unreal/
tools/

# CI, test and documentation sources are not runtime inputs.
.github/
docs/
tests/
scripts/
*.md
LANCER_HUB_3B.bat
LIRE_MOI_HUB_3B.txt

# Database history and Edge Functions deploy through Supabase. The ecosystem
# helpers remain included because Vite imports them into the web application.
supabase/migrations/
supabase/functions/*
!supabase/functions/ecosystem/
!supabase/functions/ecosystem/**

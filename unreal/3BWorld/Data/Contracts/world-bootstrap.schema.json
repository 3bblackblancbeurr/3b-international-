{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3b.international/contracts/world-bootstrap.schema.json",
  "title": "3B World Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "passport",
    "economy",
    "world",
    "city"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "passport": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "handle": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "world": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "data": {
          "type": "object"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "city": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "city_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "origin_country": {
          "type": "string"
        },
        "city_level": {
          "type": "integer",
          "minimum": 1
        },
        "placements": {
          "type": "array"
        },
        "districts": {
          "type": "array"
        }
      }
    },
    "economy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "xp",
        "coins",
        "global_level",
        "prestige_level",
        "title",
        "token_enabled",
        "token_blockchain_enabled",
        "token_trading_enabled"
      ],
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "coins": {
          "type": "integer",
          "minimum": 0
        },
        "global_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "next_level_xp": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "prestige_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "title": {
          "type": "string"
        },
        "economy_version": {
          "type": "string"
        },
        "xp_curve_version": {
          "type": "string"
        },
        "season": {
          "type": [
            "object",
            "null"
          ]
        },
        "token_enabled": {
          "const": false
        },
        "token_blockchain_enabled": {
          "const": false
        },
        "token_trading_enabled": {
          "const": false
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3b.international/contracts/city3b.schema.json",
  "title": "Ville 3B Snapshot",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "city": {
      "type": ["object","null"],
      "properties": {
        "city_id": {"type": "string", "format": "uuid"},
        "name": {"type": "string", "minLength": 2, "maxLength": 40},
        "origin_country": {"type": "string"},
        "city_level": {"type": "integer", "minimum": 1},
        "land_tier": {"type": "integer", "minimum": 1}
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","building_code","x","z","rotation"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "building_code": {"type": "string"},
          "x": {"type": "integer", "minimum": -500, "maximum": 500},
          "z": {"type": "integer", "minimum": -500, "maximum": 500},
          "rotation": {"enum": [0,90,180,270]},
          "upgrade_level": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    }
  }
}

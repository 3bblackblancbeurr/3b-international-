  "visualLaw": {
    "title": "Carte futuriste de la Cité des Huit Héritages",
    "rule": "La Cité est une métropole multi-quartiers avec huit Portes dispersées. Elle ne doit jamais être réduite à un petit cercle de huit Portes.",
    "safeZone": true,
    "combat": "aucun monstre hostile, aucun dégât, aucune mort et aucun PvP sauvage dans le Hub",
    "density": "aucun grand vide; chaque axe majeur mène à un quartier, un service, une activité, un secret ou une Porte",
    "evolution": "le retour de chaque Gardien et de chaque fragment doit produire une évolution visible et persistante de la Cité"
  },

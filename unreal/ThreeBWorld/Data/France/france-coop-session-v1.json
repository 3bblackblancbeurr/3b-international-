{
  "version": "1.0.0",
  "slice_id": "france_justice_v1",
  "purpose": "France co-op runtime/reconnect contract mapped to existing authoritative world party backend.",
  "backend": {
    "rpc": "world_party_runtime_command",
    "actions": [
      "status",
      "heartbeat",
      "down",
      "revive",
      "objective"
    ],
    "client_direct_table_access": false,
    "session_validation": true,
    "rate_limited": true
  },
  "party": {
    "max_members": 4,
    "gold_master_min_test_players": 2,
    "membership_authority": "server",
    "reconnect_restores_party_if_membership_valid": true
  },
  "runtime_states": [
    "active",
    "downed",
    "disconnected",
    "reconnecting"
  ],
  "heartbeat": {
    "region": "france",
    "server_bounds_validated": true,
    "anti_teleport_validation": true,
    "stale_member_seconds": 20
  },
  "revive": {
    "request_id_required": true,
    "idempotent_receipt": true,
    "same_party_required": true,
    "same_region_required": true,
    "max_distance": 6,
    "actor_fresh_seconds": 7,
    "target_fresh_seconds": 20,
    "target_state": "downed"
  },
  "shared_objective": {
    "request_id_required": true,
    "objective_id_server_persisted": true,
    "required_members_range": [
      2,
      4
    ],
    "max_distance_from_objective": 6,
    "active_recent_members_only": true,
    "completion_primary_key": [
      "party_id",
      "objective_id"
    ],
    "duplicate_completion_returns_existing": true
  },
  "story_rules": {
    "party_pose_or_presence_never_grants_story_reward": true,
    "story_state_remains_separate_authority": true,
    "fragment_justice_server_only": true,
    "global_xp_server_only": true,
    "reconnect_cannot_replay_reward": true
  },
  "gold_master_cases": [
    "two_players_enter_france_same_party",
    "shared_objective_completes_once",
    "downed_player_revived_in_range",
    "revive_request_replay_is_idempotent",
    "disconnect_reconnect_restores_membership",
    "reconnect_does_not_duplicate_story_reward",
    "stale_or_remote_player_cannot_satisfy_objective",
    "party_member_cannot_force_guardian_liberation"
  ]
}

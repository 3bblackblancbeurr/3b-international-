{
  "version": "1.1.0",
  "slice_id": "france_justice_v1",
  "purpose": "Preproduction contract for France population roles, scalable routines, contextual dialogue and persistent memory boundaries.",
  "authority_model": {
    "local": [
      "subtitle_rendering",
      "conversation_camera",
      "choice_highlight",
      "ambient_barks",
      "routine_presentation"
    ],
    "server_verified": [
      "persistent_memory",
      "validated_evidence",
      "rescue_outcome",
      "justice_trial_outcome",
      "guardian_liberated"
    ],
    "rule": "Dialogue and routines may request or present change; only authoritative story state may confirm durable progression."
  },
  "localization": {
    "final_dialogue_in_json": false,
    "key_prefix": "france.dialogue",
    "rule": "Store intent and localization keys here; final localized copy belongs in Unreal localization assets."
  },
  "population_rules": {
    "districts_required": 8,
    "active_ai_controller_budget": 48,
    "simulation_tiers": [
      {
        "id": "near",
        "distance_cm": 12000,
        "mode": "full_ai_navigation_dialogue"
      },
      {
        "id": "mid",
        "distance_cm": 30000,
        "mode": "scheduled_low_frequency"
      },
      {
        "id": "far",
        "distance_cm": 60000,
        "mode": "presentation_proxy_no_ai_controller"
      }
    ],
    "tick_rule": "Prefer events, timers and StateTree tasks; no per-frame routine tick for the full population.",
    "streaming_rule": "Population unloads with its World Partition cell unless mission-persistent.",
    "weather_reaction": true,
    "liberation_reaction": true
  },
  "routine_profiles": [
    {
      "id": "resident_daily",
      "slots": {
